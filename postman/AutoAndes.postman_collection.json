{
  "info": {
    "name": "AutoAndes API - LP2 Examen",
    "description": "Solicitudes de ejemplo para la base semilla local. Define baseUrl, token, username y password en variables de colección.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1"
    },
    {
      "key": "username",
      "value": "admin"
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "tokenAsesor",
      "value": ""
    },
    {
      "key": "tokenJefe",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"username\":\"{{username}}\",\"password\":\"{{password}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) { pm.collectionVariables.set('token', pm.response.json().token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Usuario actual",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/auth/me"
          }
        },
        {
          "name": "Login ASESOR (para probar 403)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"username\":\"asesor\",\"password\":\"{{password}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) { pm.collectionVariables.set('tokenAsesor', pm.response.json().token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Login JEFE_TALLER (para probar 403)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"username\":\"jefe\",\"password\":\"{{password}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) { pm.collectionVariables.set('tokenJefe', pm.response.json().token); }"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Servicios",
      "item": [
        {
          "name": "Listar servicios (200)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/servicios"
          }
        },
        {
          "name": "Crear servicio (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"codigo\":\"SRV-009\",\"nombre\":\"Revision preventiva\",\"precio\":135.5,\"duracionMin\":45}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/servicios"
          }
        },
        {
          "name": "Validación (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"codigo\":\"mal\",\"nombre\":\"\",\"precio\":0,\"duracionMin\":5}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/servicios"
          }
        },
        {
          "name": "Código duplicado (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"codigo\":\"SRV-001\",\"nombre\":\"Duplicado\",\"precio\":100,\"duracionMin\":30}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/servicios"
          }
        }
      ]
    },
    {
      "name": "Vehículos y permisos",
      "item": [
        {
          "name": "Listar vehículos (200)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/vehiculos"
          }
        },
        {
          "name": "Vehículo inexistente (404)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/vehiculos/999999"
          }
        },
        {
          "name": "Sin token (401)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/vehiculos"
          }
        },
        {
          "name": "Asesor intenta ver reporte (403)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAsesor}}"
              }
            ],
            "url": "{{baseUrl}}/reportes/ingresos-por-servicio?desde=2026-10-01&hasta=2026-10-31"
          }
        }
      ]
    },
    {
      "name": "Órdenes y reporte",
      "item": [
        {
          "name": "Registrar orden (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"vehiculoId\":1,\"kilometraje\":45500,\"detalles\":[{\"servicioId\":1,\"cantidad\":1},{\"servicioId\":2,\"cantidad\":1}]}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/ordenes"
          }
        },
        {
          "name": "Kilometraje menor (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"vehiculoId\":1,\"kilometraje\":44000,\"detalles\":[{\"servicioId\":1,\"cantidad\":1}]}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/ordenes"
          }
        },
        {
          "name": "Consultar órdenes (200)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/ordenes?placa=AAA-111&estado=REGISTRADA&desde=2026-10-01&hasta=2026-10-31"
          }
        },
        {
          "name": "Reporte por servicio (200)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/reportes/ingresos-por-servicio?desde=2026-10-01&hasta=2026-10-31"
          }
        }
      ]
    }
  ]
}
